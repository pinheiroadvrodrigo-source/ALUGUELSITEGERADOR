---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, waLink } from '../data/site';
---
<BaseLayout title="Página não encontrada | ParaPrime" description="A página procurada não existe. Use o menu para encontrar o aluguel de gerador em Belém e Região Metropolitana ou fale com a ParaPrime pelo WhatsApp." path="/404" noindex formOnPage={false}>
  <section class="section"><div class="container narrow" style="text-align:center">
    <h1>Página não encontrada</h1>
    <p>Use o menu acima para ver os serviços e as áreas atendidas, ou fale direto com a {SITE.marca}.</p>
    <a class="btn btn--primary" href={waLink()} target="_blank" rel="noopener" data-track="whatsapp_click" data-cta-position="404"><Icon name="whatsapp" />Falar no WhatsApp</a>
  </div></section>
</BaseLayout>
