---
// TEMPLATE 1b — Índice de serviços. Corpo sem links além da marca (topologia estrela);
// a navegação até cada serviço é feita pelo menu global.
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLead from '../components/BrandLead.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/Stats.astro';
import Faq from '../components/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { SITE, waLink } from '../data/site';
import { SERVICOS } from '../data/servicos';
import { LOCALIDADES } from '../data/localidades';

const porTicket = [...SERVICOS].sort((a, b) => a.ordemTicket - b.ordemTicket);
const wa = waLink(`Olá! Vim pelo site da ${SITE.marca} e quero ajuda para escolher o gerador.`);
const faq = [
  { pergunta: 'Qual serviço de aluguel de gerador eu devo escolher?', resposta: 'Pelo uso: indústria e grandes consumidores ficam na locação industrial; canteiros, no gerador para obras; shows, feiras e casamentos, no gerador para eventos; prédios, no gerador para condomínio; e casas e sítios, no gerador residencial.' },
  { pergunta: 'Todos os serviços atendem a Região Metropolitana de Belém?', resposta: 'Sim. Todos os serviços atendem Belém, Ananindeua, Marituba, Benevides, Castanhal e Barcarena, com frete calculado pela distância.' },
  { pergunta: 'O combustível está incluído no aluguel do gerador?', resposta: 'Normalmente não. O diesel é cobrado à parte, pelo consumo, ou fornecido pelo próprio cliente, conforme o contrato.' },
  { pergunta: 'Dá para alugar por um único dia?', resposta: 'Sim, em todas as modalidades. Para períodos de 28 dias ou mais, a diária equivalente cai bastante.' },
];
---
<BaseLayout title="Serviços de Aluguel de Gerador em Belém | ParaPrime"
  description="Serviços de aluguel de gerador em Belém: locação industrial, eventos, obras, condomínios e residências, de 5 a 1.000+ kVA. Orçamento pelo WhatsApp (91) 99119-8584."
  path="/servicos" formOnPage={false}
  crumbs={[{ label: 'Início', href: '/' }, { label: 'Serviços' }]}>
  <section class="hero hero--short">
    <div class="hero__bg"><img src="/img/fotos/gerador-aluguel-belem-hero.webp" alt="Geradores diesel de diferentes potências para locação em Belém - PA" width="1200" height="800" fetchpriority="high" /></div>
    <div class="container"><div class="on-photo" style="max-width:820px">
      <span class="eyebrow">Catálogo</span>
      <h1>Serviços de Aluguel de Gerador em Belém | Da Casa à Indústria, de 5 a 1.000+ kVA</h1>
      <BrandLead class="hero__lead" texto="A {MARCA} reúne cinco modalidades de locação de gerador para Belém e Região Metropolitana, organizadas do maior para o menor porte. Escolha pelo uso e fale com a gente pelo WhatsApp para fechar o kVA." />
      <div class="btn-row"><a class="btn btn--primary" href={wa} target="_blank" rel="noopener" data-track="whatsapp_click" data-cta-position="hero"><Icon name="whatsapp" />Falar no WhatsApp</a></div>
    </div></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading"><span class="eyebrow">Categorias</span><h2>Aluguel de Gerador por Tipo de Uso em Belém</h2></div>
      <div class="grid grid--3">
        <article class="card"><div class="icon-chip"><Icon name="bolt" /></div><h3>Indústria e grandes consumidores</h3><p>Contingência, manutenção de subestação e paralelismo acima de 500 kVA.</p><span class="spec">100–1.000+ KVA</span></article>
        <article class="card"><div class="icon-chip"><Icon name="wrench" /></div><h3>Obras e eventos</h3><p>Energia temporária que acompanha o cronograma do canteiro ou a duração do evento.</p><span class="spec">20–500 KVA</span></article>
        <article class="card"><div class="icon-chip"><Icon name="plug" /></div><h3>Condomínios e residências</h3><p>Elevadores, bombas, portões e a casa funcionando durante falta de energia.</p><span class="spec">5–150 KVA</span></article>
      </div>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <div class="section-heading"><span class="eyebrow">Lista completa</span><h2>Todos os Serviços de Locação de Gerador da ParaPrime</h2><p>Use o menu Serviços, no topo, para abrir o detalhe técnico de cada modalidade.</p></div>
      <div class="grid grid--3">
        {porTicket.map((s) => (
          <article class="service-card">
            <div class="service-card__img"><img src={s.hero.src} alt={s.hero.alt} width="600" height="400" loading="lazy" /></div>
            <div class="service-card__body"><h3>{s.h1.split(' | ')[0]}</h3><p>{s.resumoCard}</p><span class="spec">{s.specCard}</span></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container two-col">
      <div>
        <span class="eyebrow">Método</span>
        <h2>Dimensionamento de Gerador pela Carga Real em Belém</h2>
        <p>Toda proposta parte da mesma conta: potência das cargas que funcionam juntas, em kW, dividida pelo fator de potência 0,8 para chegar ao kVA, mais folga para a partida de motores e compressores. A ligação é sempre feita com chave de transferência, conforme a NBR 5410 e a NR-10.</p>
      </div>
      <Stats itens={[
        { valor: 'kVA = kW ÷ 0,8', rotulo: 'conversão usada na maioria das instalações' },
        { valor: '5–1.000+ kVA', rotulo: 'do portátil ao paralelismo industrial' },
        { valor: '28 dias', rotulo: 'contrato a partir do qual a diária cai' },
      ]} />
    </div>
  </section>

  <section class="section">
    <div class="container two-col two-col--top">
      <div>
        <span class="eyebrow">Cobertura</span>
        <h2>Cidades Atendidas pelos Serviços de Gerador</h2>
        <p>Belém e Região Metropolitana. A lista completa, com bairros, está na página Áreas atendidas, no menu.</p>
        <ul class="chips"><li>Belém</li>{LOCALIDADES.map((l) => <li>{l.cidade}</li>)}</ul>
      </div>
      <div><Faq itens={faq} /></div>
    </div>
  </section>

  <CtaBanner titulo="Não sabe qual gerador alugar? A gente calcula com você" texto="Mande a lista do que precisa ligar pelo WhatsApp e receba a indicação de potência e a proposta." somenteWhatsapp formOnPage={false} />
</BaseLayout>
