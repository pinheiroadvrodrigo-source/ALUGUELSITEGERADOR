---
// TEMPLATE 1g — Áreas atendidas. ÚNICA página com link grid no corpo (exceção autorizada):
// links só para páginas de localidade. Bairro sem página = texto.
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLead from '../components/BrandLead.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/Stats.astro';
import Faq from '../components/Faq.astro';
import MapFacade from '../components/MapFacade.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { SITE, waLink } from '../data/site';
import { SERVICOS } from '../data/servicos';
import { LOCALIDADES } from '../data/localidades';

const wa = waLink(`Olá! Vim pelo site da ${SITE.marca}. Vocês atendem o meu endereço?`);
const regioes = [
  { nome: 'Belém (capital)', cidades: [{ nome: 'Belém', bairros: 'Umarizal, Nazaré, Batista Campos, Reduto, Marco, Pedreira, Marambaia, Augusto Montenegro, Icoaraci, Mosqueiro' }] },
  { nome: 'Eixo BR-316', cidades: LOCALIDADES.filter((l) => ['Ananindeua', 'Marituba', 'Benevides'].includes(l.cidade)).map((l) => ({ nome: l.cidade, slug: l.slug, bairros: l.bairros.join(', ') })) },
  { nome: 'Nordeste paraense', cidades: [
    ...LOCALIDADES.filter((l) => l.cidade === 'Castanhal').map((l) => ({ nome: l.cidade, slug: l.slug, bairros: l.bairros.join(', ') })),
    { nome: 'Santa Izabel do Pará', bairros: 'sob consulta de logística' },
    { nome: 'Santa Bárbara do Pará', bairros: 'sob consulta de logística' },
  ] },
  { nome: 'Polo industrial', cidades: LOCALIDADES.filter((l) => l.cidade === 'Barcarena').map((l) => ({ nome: l.cidade, slug: l.slug, bairros: l.bairros.join(', ') })) },
];
const faq = [
  { pergunta: 'Vocês atendem a minha cidade?', resposta: 'Atendemos Belém e os municípios da Região Metropolitana listados nesta página. Para outras cidades do Pará, mande o endereço pelo WhatsApp e confirmamos a logística.' },
  { pergunta: 'Vocês cobram deslocamento?', resposta: 'Sim. O frete de entrega e retirada é calculado pela distância e pelo porte do gerador, e aparece separado na proposta.' },
  { pergunta: 'Quanto tempo leva para o gerador chegar?', resposta: 'Em Belém e no eixo da BR-316, de 24 a 72 horas após a aprovação, conforme disponibilidade. Barcarena e Castanhal podem levar um pouco mais pela distância.' },
  { pergunta: 'Atendem Icoaraci e Mosqueiro?', resposta: 'Sim, os distritos de Belém estão dentro da área de atendimento. A visita técnica confirma o acesso para o caminhão.' },
];
---
<BaseLayout title="Áreas Atendidas | Aluguel de Gerador na Grande Belém"
  description="Áreas atendidas pela ParaPrime: aluguel de gerador em Belém, Ananindeua, Marituba, Benevides, Castanhal e Barcarena. Confirme seu endereço: (91) 99119-8584."
  path="/areas-atendidas" formOnPage={false}
  crumbs={[{ label: 'Início', href: '/' }, { label: 'Áreas atendidas' }]}>
  <section class="hero hero--short">
    <div class="hero__bg"><img src="/img/fotos/mapa-belem-pa.webp" alt="Mapa da Região Metropolitana de Belém - PA, área de aluguel de gerador" width="1200" height="450" fetchpriority="high" /></div>
    <div class="container"><div class="on-photo" style="max-width:820px">
      <span class="eyebrow">Cobertura</span>
      <h1>Áreas Atendidas — Aluguel de Gerador na Região Metropolitana de Belém</h1>
      <BrandLead class="hero__lead" texto="A {MARCA} atende Belém e a Região Metropolitana — que, desde 2023, reúne oito municípios: Belém, Ananindeua, Marituba, Benevides, Santa Bárbara do Pará, Santa Izabel do Pará, Castanhal e Barcarena." />
      <div class="btn-row"><a class="btn btn--primary" href={wa} target="_blank" rel="noopener" data-track="whatsapp_click" data-cta-position="hero"><Icon name="whatsapp" />Falar no WhatsApp</a></div>
    </div></div>
  </section>

  <section class="section">
    <div class="container two-col">
      <MapFacade query="Região Metropolitana de Belém, PA, Brasil" imagem={{ src: '/img/fotos/mapa-belem-pa.webp', alt: 'Mapa da cobertura de aluguel de gerador na Região Metropolitana de Belém - PA', w: 1200, h: 450 }} localidade="Região Metropolitana de Belém" />
      <Stats light itens={[
        { valor: '8 municípios', rotulo: 'na Região Metropolitana de Belém', fonte: 'Brasil de Fato / Censo 2022' },
        { valor: '6 com página', rotulo: 'Belém + 5 cidades com atendimento detalhado' },
        { valor: '24–72 h', rotulo: 'prazo típico de entrega no eixo BR-316' },
      ]} />
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <div class="section-heading"><span class="eyebrow">Cidades principais</span><h2>Cidades com Atendimento de Gerador Detalhado</h2></div>
      <div class="grid grid--3">
        {LOCALIDADES.map((l) => (
          <a class="service-card" href={`/${l.slug}`}>
            <div class="service-card__img"><img src={l.hero.src} alt={l.hero.alt} width="600" height="400" loading="lazy" /></div>
            <div class="service-card__body"><h3>{l.servicoAncora} em {l.cidade}</h3><p>{l.resumoArea}</p><span class="spec">{l.bairros.slice(0, 3).join(' · ')}</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading"><span class="eyebrow">Índice</span><h2>Índice de Cidades e Bairros Atendidos por Região</h2></div>
      <input class="area-search field" type="search" placeholder="Busque sua cidade ou bairro" aria-label="Buscar cidade ou bairro" data-area-search style="width:100%;min-height:48px;padding:10px 14px;border:1.5px solid var(--border-default);border-radius:6px;font:inherit" />
      <div class="grid grid--4">
        {regioes.map((r) => (
          <div data-regiao>
            <h3>{r.nome}</h3>
            <ul style="list-style:none;padding:0;margin:0;display:grid;gap:14px">
              {r.cidades.map((c: { nome: string; slug?: string; bairros: string }) => (
                <li data-item={`${c.nome} ${c.bairros}`.toLowerCase()}>
                  {c.slug ? <a href={`/${c.slug}`} style="font-weight:700">{c.nome}</a> : <strong>{c.nome}</strong>}
                  <span style="display:block;font-size:13.5px;color:var(--text-muted)">{c.bairros}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <div class="section-heading"><span class="eyebrow">Serviços × área</span><h2>Serviços de Gerador em Toda a Região Metropolitana de Belém</h2></div>
      <div class="grid grid--3">
        {[...SERVICOS].sort((a, b) => a.ordemTicket - b.ordemTicket).map((s) => (
          <article class="card" style="background:var(--navy-900);border-color:var(--border-ink)"><h3>{s.nome} em toda a região</h3><p>{s.resumoCard}</p><span class="spec">{s.specCard}</span></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="section-heading section-heading--center"><span class="eyebrow">Cobertura</span><h2>Perguntas sobre a Área de Atendimento de Geradores</h2></div>
      <Faq itens={faq} />
    </div>
  </section>

  <CtaBanner titulo="Não achou sua cidade? Pergunte no WhatsApp" texto="Mande o endereço e o que precisa ligar. Confirmamos se atendemos e quanto custa o frete." somenteWhatsapp formOnPage={false} mensagem={`Olá! Vim pelo site da ${SITE.marca}. Vocês atendem o meu endereço?`} posicao="cta_nao_achou_cidade" />
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-area-search]');
  input?.addEventListener('input', () => {
    const q = input.value.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    document.querySelectorAll<HTMLElement>('[data-item]').forEach((li) => {
      const t = (li.dataset.item || '').normalize('NFD').replace(/[̀-ͯ]/g, '');
      li.style.display = !q || t.includes(q) ? '' : 'none';
    });
  });
</script>
