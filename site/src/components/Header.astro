---
import Icon from './Icon.astro';
import ChatWidget from './ChatWidget.astro';
import { SITE, waLink } from '../data/site';
import { SERVICOS } from '../data/servicos';
import { LOCALIDADES } from '../data/localidades';
interface Props { path: string; localidade?: string; servico?: string }
const { path, localidade = '', servico = '' } = Astro.props;
const wa = waLink();
const cur = (href: string) => (path === href ? 'page' : undefined);
const servicos = [...SERVICOS].sort((a, b) => a.ordemTicket - b.ordemTicket);
---
<div class="utilitybar">
  <div class="container">
    <span>Aluguel de geradores em Belém e Região Metropolitana · <span class="mono">20–1.000+ kVA</span></span>
    <span>{SITE.horario} · <a class="utilitybar__wa" href={wa} target="_blank" rel="noopener" data-track="whatsapp_click" data-cta-position="telefone_utilitybar">WhatsApp <span class="mono">{SITE.telefoneExibe}</span></a></span>
  </div>
</div>
<header class="site-header">
  <div class="container">
    <a class="site-header__logo" href="/" aria-label={`${SITE.marcaCompleta} — página inicial`}>
      <img src="/img/paraprime-aluguel-de-geradores-logo.webp" alt={`${SITE.marcaCompleta} — logo`} width="210" height="70" fetchpriority="high" />
    </a>
    <nav class="nav" aria-label="Menu principal">
      <div class="nav-item">
        <a href="/servicos" aria-current={cur('/servicos')}>Serviços</a>
        <div class="nav-item__panel">
          {servicos.map((s) => <a href={`/${s.slug}`}>{s.nome}</a>)}
        </div>
      </div>
      <div class="nav-item">
        <a href="/areas-atendidas" aria-current={cur('/areas-atendidas')}>Áreas atendidas</a>
        <div class="nav-item__panel">
          {LOCALIDADES.map((l) => <a href={`/${l.slug}`}>{l.servicoAncora} em {l.cidade}</a>)}
        </div>
      </div>
      <a href="/sobre" aria-current={cur('/sobre')}>Como funciona</a>
      <a href="/contato" aria-current={cur('/contato')}>Contato</a>
    </nav>
    <div class="header-actions">
      <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" data-menu-toggle><Icon name="menu" /></button>
    </div>
  </div>
  <ChatWidget />
  <div class="drawer" data-drawer data-open="false">
    <h2>Serviços</h2>
    <ul>{servicos.map((s) => <li><a href={`/${s.slug}`}>{s.nome}</a></li>)}</ul>
    <h2>Áreas atendidas</h2>
    <ul>{LOCALIDADES.map((l) => <li><a href={`/${l.slug}`}>{l.cidade} — {l.servicoAncora.toLowerCase()}</a></li>)}<li><a href="/areas-atendidas">Todas as áreas</a></li></ul>
    <h2>Institucional</h2>
    <ul><li><a href="/servicos">Todos os serviços</a></li><li><a href="/sobre">Como funciona</a></li><li><a href="/contato">Contato</a></li></ul>
  </div>
</header>
