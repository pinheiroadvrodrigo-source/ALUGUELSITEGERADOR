---
import Icon from './Icon.astro';
import { SITE, waLink } from '../data/site';
interface Props { eyebrow?: string; titulo: string; texto: string; formOnPage?: boolean; mensagem?: string; posicao?: string; somenteWhatsapp?: boolean }
const { eyebrow, titulo, texto, formOnPage = true, mensagem, posicao = 'cta_final', somenteWhatsapp = false } = Astro.props;
const wa = waLink(mensagem ?? `Olá! Vim pelo site da ${SITE.marca} e quero um orçamento de aluguel de gerador.`);
---
<section class="cta-banner on-photo">
  <img src="/img/fotos/cta-gerador-aluguel-belem-noite.webp" alt="" width="1200" height="500" loading="lazy" aria-hidden="true" />
  <div class="container">
    <div>
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2>{titulo}</h2>
      <p>{texto}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--primary" href={wa} target="_blank" rel="noopener" data-track="whatsapp_click" data-cta-position={posicao}><Icon name="whatsapp" />Falar no WhatsApp</a>
      {!somenteWhatsapp && <a class="btn btn--secondary" href={formOnPage ? '#orcamento' : '/contato#orcamento'} data-track="cta_click" data-cta-position={`${posicao}_orcamento`}>Pedir orçamento</a>}
    </div>
  </div>
</section>
